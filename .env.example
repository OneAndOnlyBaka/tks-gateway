# Copy to .env and adjust.

# Serial adapter on the host (ls -l /dev/serial/by-id/)
SERIAL_DEVICE=/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_BG04PJMA-if00-port0

# Rootless Podman: keep-groups. Docker: numeric GID of dialout (getent group dialout)
SERIAL_GROUP=keep-groups

# 0.0.0.0 makes the UI reachable on the network (no login!)
BIND_ADDRESS=127.0.0.1
HTTP_PORT=5000
